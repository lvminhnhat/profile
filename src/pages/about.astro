---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Minh Nhat" description="About Lam Vu Minh Nhat - Full-stack Developer">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
				tagline="Thanks for stopping by. Read below to learn more about myself and my background."
			>
				<img
					width="1553"
					height="873"
					src="/assets/at-work.jpg"
					alt="Minh Nhat at work"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						I'm Minh Nhat — a full-stack developer based in Ho Chi Minh City, Vietnam. I specialize
						in building AI-powered applications, scalable REST APIs, and cross-platform desktop tools
						using Python, TypeScript/JavaScript, and Go.
					</p>
					<p>
						With 30+ personal projects on GitHub and internship experience at Bloommedia JSC and
						THD Cybersecurity, I've worked across the full stack — from Django/FastAPI backends with
						Redis caching and JWT auth, to React + Ant Design frontends with modern testing setups.
					</p>
					<p>
						My competitive programming background (Codeforces rating 1658, Provincial Informatics
						Second Prize) drives my passion for clean problem-solving and efficient algorithms.
						I'm always looking for ways to leverage AI tools to accelerate development workflows
						and solve real-world problems.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p><strong>ITMO University</strong> — Applied Computer Science</p>
					<p>Saint Petersburg, Russia · Graduation: 2025</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Skills</h2>
				<div class="content">
					<p><strong>Languages:</strong> Python, TypeScript/JavaScript, Go, SQL, HTML/CSS, Shell</p>
					<p><strong>Backend:</strong> FastAPI, Django/DRF, Flask, Express.js, Gin, Fiber, GraphQL, tRPC</p>
					<p><strong>Frontend:</strong> React 18/19, Next.js 16, Astro, Tailwind CSS, Radix UI/shadcn, Ant Design</p>
					<p><strong>AI/ML:</strong> OpenAI API, Google Gemini, MCP Server, OpenCV, scikit-learn, Tesseract OCR</p>
					<p><strong>Databases:</strong> PostgreSQL, MongoDB, Redis, SQLite, Prisma ORM</p>
					<p><strong>DevOps:</strong> Docker, AWS S3, Cloudflare Workers, GitHub Actions CI/CD, Nginx</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
